{
    "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**", "!public", "!**/*.svg", "!**/*.mdx"]
    },
    "html": {
        "experimentalFullSupportEnabled": true
    },
    "linter": {
        "rules": {
            "correctness": {
                "useImportExtensions": "on",
                "noUnusedFunctionParameters": "on",
                "noUndeclaredDependencies": "on",
                "noUnusedPrivateClassMembers": "on",
                "noUnusedInstantiation": "on"
            },
            "suspicious": {
                "noShadow": "on",
                "noEvolvingTypes": "on",
                "useAwait": "on",
                "noImportCycles": "on",
                "useErrorMessage": "on"
            },
            "complexity": {
                "noUselessUndefined": "on"
            },
            "style": {
                "useSelfClosingElements": "on",
                "noParameterAssign": "on",
                "useConsistentArrayType": "on",
                "useForOf": "on",
                "useCollapsedIf": "on",
                "useExplicitLengthCheck": "on",
                "useThrowNewError": "on",
                "useNodejsImportProtocol": "on",
                "noNonNullAssertion": "on"
            },
            "nursery": {
                "noFloatingPromises": "on",
                "noMisusedPromises": "on"
            }
        }
    }
}
