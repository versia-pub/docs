{
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "deno run -A npm:next dev",
        "build": "deno run -A npm:next build && deno run -A npm:pagefind --site out",
        "start": "deno run -A npm:next start",
        "analyze": "deno run -A npm:next analyze",
        "typecheck": "deno run -A npm:next typegen && deno run -A npm:typescript/tsc -p .",
        "lint": "deno run -A npm:@biomejs/biome check .",
        "check-links": "deno run -A scripts/check-links.mjs",
        "knip": "deno run -A npm:knip",
        "uuid": "deno eval \"console.log(crypto.randomUUID())\""
    }
}
