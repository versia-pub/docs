---
import Search from "@astrojs/starlight/components/Search.astro";
import { CURRENT_VERSION } from "../../lib/spec";
import ThemeSelect from "./ThemeSelect.astro";
---

<div class="masthead">
    <a class="brand" href="/">
        <img src="/logo.webp" width="28" height="28" alt="" />
        <span>Versia</span>
    </a>
    <a class="version" href="/changelog">{CURRENT_VERSION}</a>
</div>
<div class="rail-tools">
    <Search />
    <ThemeSelect />
</div>

<style>
    .masthead {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--ink);
        font-weight: var(--weight-bold);
        font-size: 1.25rem;
        text-decoration: none;
    }

    .brand img {
        border-radius: 6px;
    }

    /* Below the breakpoint the version moves to the drawer, in `Sidebar`. */
    .version {
        display: none;
        color: var(--ink-soft);
        font-size: var(--text-xs);
        text-decoration: none;
    }

    .version:hover {
        color: var(--accent);
    }

    .rail-tools {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* A field the eye can find: the paper colour and a border against the shaded rail. */
    .rail-tools :global(site-search button[data-open-modal]) {
        height: 2.25rem;
        padding-inline: 0.6rem;
        color: var(--ink-soft);
        background: var(--paper);
        border: 1px solid var(--control-border);
        border-radius: var(--radius);
        font-size: var(--text-sm);
    }

    .rail-tools :global(site-search button[data-open-modal]:hover) {
        color: var(--ink);
        border-color: var(--ink-faint);
    }

    .rail-tools :global(site-search button[data-open-modal] kbd) {
        color: var(--ink-faint);
        background: none;
        font-family: var(--font-mono);
        font-size: var(--code-size);
    }

    @media (min-width: 50rem) {
        .version {
            display: block;
        }

        .rail-tools :global(site-search) {
            flex: 1;
        }

        .rail-tools :global(site-search button[data-open-modal]) {
            width: 100%;
            max-width: none;
        }
    }

    /* Search and the theme toggle need JavaScript, so they are hidden rather than shown as dead
       controls. */
    @media (scripting: none) {
        .rail-tools {
            display: none;
        }
    }
</style>
