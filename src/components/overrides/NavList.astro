---
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type Entry = StarlightRouteData["sidebar"][number];

interface Props {
    entries: Entry[];
}

const { entries } = Astro.props;
const { headings } = Astro.locals.starlightRoute;

const sections = headings.filter((heading) => heading.depth === 2);
---

<ul class="nav-list">
    {entries.map((entry) => (
        <li>
            {entry.type === "link" ? (
                <>
                    <a
                        href={entry.href}
                        class:list={["nav-link", entry.attrs.class]}
                        aria-current={entry.isCurrent ? "page" : undefined}
                    >
                        {entry.label}
                    </a>
                    {entry.isCurrent && sections.length > 0 && (
                        <ul class="sublinks">
                            {sections.map((section) => (
                                <li><a href={`#${section.slug}`}>{section.text}</a></li>
                            ))}
                        </ul>
                    )}
                </>
            ) : (
                <>
                    <p class="nav-label">{entry.label}</p>
                    <Astro.self entries={entry.entries} />
                </>
            )}
        </li>
    ))}
</ul>

<style>
    .nav-label {
        margin: 1.5rem 0 0.4rem;
        color: var(--ink);
        font-size: var(--text-sm);
        font-weight: var(--weight-bold);
    }

    .nav-list > li:first-child > .nav-label {
        margin-top: 0;
    }

    .nav-list,
    .sublinks {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .nav-link {
        display: block;
        padding: 0.2rem 0;
        color: var(--ink-soft);
        font-size: var(--text-sm);
        line-height: 1.45;
        text-decoration: none;
    }

    .nav-link:hover {
        color: var(--ink);
    }

    .nav-link[aria-current="page"] {
        color: var(--accent);
        font-weight: var(--weight-bold);
    }

    /* `ident` is set in the sidebar config, on entries named after identifiers. */
    .nav-link.ident {
        font-family: var(--font-mono);
        font-size: var(--code-size);
    }

    .sublinks {
        margin: 0.1rem 0 0.5rem;
        padding-left: 0.75rem;
    }

    .sublinks a {
        display: block;
        padding: 0.15rem 0;
        color: var(--ink-soft);
        font-size: var(--text-sm);
        line-height: 1.35;
        text-decoration: none;
    }

    /* `is-current` comes from the scroll spy in `Sidebar`. */
    .sublinks a:hover,
    .sublinks a.is-current {
        color: var(--ink);
    }

    .sublinks a.is-current {
        margin-left: -0.75rem;
        padding-left: calc(0.75rem - 2px);
        border-left: 2px solid var(--accent);
    }
</style>
