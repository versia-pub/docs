<div class="prose"><slot /></div>

<style is:global>
    /* Global because elements from Markdown are outside any component's scope. `:where` keeps
       the element rules at the lowest specificity, so any class in a component outranks them. */

    /* One column for reading, with a margin column for short notes on wide screens. */
    .prose {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        font-size: 1.0625rem;
        line-height: 1.65;
    }

    .prose > * {
        grid-column: 1;
        min-width: 0;
        max-width: var(--prose-width);
    }

    .prose > .sheet,
    .prose > .wide {
        grid-column: 1 / -1;
        max-width: none;
    }

    @media (min-width: 78rem) {
        .prose {
            grid-template-columns: minmax(0, var(--prose-width)) var(--margin-width);
            column-gap: 3rem;
        }

        .prose > .note {
            grid-column: 2;
            grid-row-end: span 4;
            align-self: start;
        }
    }

    :where(.prose) p,
    :where(.prose) ul,
    :where(.prose) ol {
        margin: 0 0 1em;
    }

    :where(.prose) ul,
    :where(.prose) ol {
        padding-left: 1.25em;
    }

    :where(.prose) li + li {
        margin-top: 0.25em;
    }

    :where(.prose) h2 {
        margin: 3rem 0 0.75rem;
        padding-top: 0.6rem;
        border-top: 2px solid var(--ink);
        color: var(--ink);
        font-family: var(--font-prose);
        font-size: 1.625rem;
        font-weight: 650;
        line-height: 1.2;
    }

    /* A sheet brings its own rule, right under the heading. */
    :where(.prose) h2:has(+ .sheet) {
        padding-top: 0;
        border-top: 0;
    }

    :where(.prose) h3 {
        margin: 2rem 0 0.5rem;
        color: var(--ink);
        font-family: var(--font-prose);
        font-size: 1.125rem;
        font-weight: 700;
        line-height: 1.3;
    }

    :where(.prose) a {
        color: var(--accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.15em;
    }

    :where(.prose) strong {
        font-weight: 650;
    }

    /* RFC 2119 keywords read the same everywhere, however the source capitalizes them. */
    :where(.prose) strong.normative {
        font-size: 0.85em;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    :where(.prose) code {
        font-family: var(--font-mono);
    }

    :where(.prose) :not(pre) > code {
        font-size: 0.84em;
    }

    /* Used directly in MDX: a row of buttons. */
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin-block: 1.5rem;
    }

    /* Used directly in MDX. The graph is drawn in light lines, so it needs a dark background
       in both themes. */
    .graph {
        padding: 1rem;
        border: 1px solid var(--hair);
        background: #27272a;
    }

    .graph img {
        width: 100%;
    }
</style>
