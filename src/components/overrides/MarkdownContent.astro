<div class="prose"><slot /></div>

<style is:global>
    /* Global because elements from Markdown are outside any component's scope. `:where` keeps
       the element rules at the lowest specificity, so any class in a component outranks them. */

    /* One column for reading. `flow-root` keeps a note that runs past the last paragraph inside. */
    .prose {
        display: flow-root;
        font-size: var(--text-body);
        /* Past Butterick's 145%, since the lines run long at about 80 characters. */
        line-height: 1.5;
    }

    .prose > *,
    .noted > * {
        min-width: 0;
        max-width: var(--prose-width);
    }

    .prose > .sheet,
    .prose > .wide {
        clear: right;
        max-width: none;
    }

    /* A note that pushes a sheet down pushes the heading above it too. */
    .prose > :is(h2, h3):has(+ .sheet, + .wide) {
        clear: right;
    }

    /* `rehypeNotesBesideText` puts a note before the text it follows, in this wrapper. A float
       cannot rise above its place in the source, so that is what lets it start level with the text.
       Narrow screens have no margin for it, so they restore the reading order. */
    .noted {
        display: flex;
        flex-direction: column;
    }

    .noted > .note {
        order: 1;
    }

    /* On wide screens, short notes float beside the reading column. Floating leaves the height of
       the column to its own text, however long a note gets. */
    @media (min-width: 78rem) {
        .noted {
            display: contents;
        }

        .prose > :not(.sheet, .wide, .note, .noted),
        .noted > :not(.note) {
            max-width: min(var(--prose-width), 100% - var(--margin-width) - var(--margin-gap));
        }

        /* With no text to sit beside, a note opening the page stays in the column. Floated, it
           would leave a blank space where the text should be. */
        .prose > .note:not(:first-child),
        .noted > .note {
            float: right;
            width: var(--margin-width);
            max-width: none;
            margin: 0.3em 0 1rem var(--margin-gap);
        }
    }

    :where(.prose) p,
    :where(.prose) ul,
    :where(.prose) ol {
        margin: 0 0 0.75em;
        text-wrap: pretty;
    }

    :where(.prose) ul,
    :where(.prose) ol {
        padding-left: 1.25em;
    }

    :where(.prose) li + li {
        margin-top: 0.25em;
    }

    :where(.prose) h2 {
        /* Space alone sets a section apart, and more of it above ties the heading to its text. */
        margin: 3.25rem 0 0.5rem;
        color: var(--ink);
        font-family: var(--font-prose);
        font-size: 1.375rem;
        font-weight: var(--weight-bold);
        line-height: 1.25;
        text-wrap: balance;
    }

    :where(.prose) h3 {
        margin: 2rem 0 0.25rem;
        color: var(--ink);
        font-family: var(--font-prose);
        font-size: var(--text-body);
        font-weight: var(--weight-bold);
        line-height: 1.3;
        text-wrap: balance;
    }

    :where(.prose) a {
        color: var(--accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.15em;
    }

    :where(.prose) strong {
        font-weight: var(--weight-bold);
    }

    /* RFC 2119 keywords read the same everywhere, however the source capitalizes them. */
    :where(.prose) strong.normative {
        font-size: 0.85em;
        font-weight: var(--weight-bold);
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    :where(.prose) code {
        font-family: var(--font-mono);
    }

    /* A line height of its own would stop inline code from pushing lines apart. */
    :where(.prose) :not(pre) > code {
        font-size: calc(var(--mono-ratio) * 1em);
        line-height: 1;
    }

    /* Used directly in MDX: a row of buttons. */
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin-block: 1.5rem;
    }

    /* Used directly in MDX. The graph is drawn in light lines, so it needs a dark background
       in both themes. */
    .graph {
        padding: 1rem;
        border: 1px solid var(--hair);
        background: #27272a;
    }

    .graph img {
        width: 100%;
    }
</style>
