---
import CopyButtons from "../CopyButtons.astro";
import Uwuify from "../Uwuify.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<CopyButtons />
<Uwuify />

<div class="frame">
    <div class="rail">
        <header class="rail-head"><slot name="header" /></header>
        {hasSidebar && (
            <nav class="rail-nav" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
                {/* The popover opens and closes without JavaScript. */}
                <button class="menu-button" popovertarget="site-nav">
                    <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                        <path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.5" fill="none" />
                    </svg>
                    <span class="sr-only">{Astro.locals.t("menuButton.accessibleLabel")}</span>
                </button>
                <div id="site-nav" popover="auto" class="nav-pane"><slot name="sidebar" /></div>
            </nav>
        )}
    </div>
    <div class="main-frame"><slot /></div>
</div>

<style>
    .frame {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
    }

    /* Small screens: the rail is a top bar, and the navigation is a popover below it. */
    .rail {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        height: 3.5rem;
        padding-inline: 1rem;
        background: var(--paper-raised);
        border-bottom: 1px solid var(--hair);
    }

    .rail-head {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        min-width: 0;
    }

    .menu-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        margin-left: 0.5rem;
        padding: 0;
        color: var(--ink-soft);
        background: var(--paper);
        border: 1px solid var(--control-border);
        border-radius: var(--radius);
        cursor: pointer;
    }

    .menu-button:hover {
        color: var(--ink);
        border-color: var(--ink-faint);
    }

    /* A drawer, not a full-screen sheet. Without JavaScript the menu cannot close itself after
       a jump to a section, so the page stays visible and tapping it closes the menu. */
    .nav-pane {
        position: fixed;
        inset: 3.5rem 0 0 auto;
        width: min(20rem, 85vw);
        height: calc(100dvh - 3.5rem);
        margin: 0;
        padding: 1rem 1.25rem 2rem;
        overflow-y: auto;
        color: var(--ink);
        background: var(--paper-raised);
        border: 0;
        border-left: 1px solid var(--hair);
    }

    /* Large screens: a full-height rail. The header sits inside it, so there is no top bar. */
    @media (min-width: 50rem) {
        .frame {
            grid-template-columns: var(--rail-width) minmax(0, 1fr);
        }

        .rail {
            height: 100dvh;
            flex-direction: column;
            align-items: stretch;
            padding: 0;
            border-bottom: 0;
            border-right: 1px solid var(--hair);
        }

        /* The masthead and search stay in place, and only the long list below them scrolls. */
        .rail-head {
            flex: none;
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
            padding: 1.25rem 1.25rem 1.5rem;
        }

        .rail-nav {
            flex: 1;
            min-height: 0;
            padding-inline: 1.25rem;
            overflow-y: auto;
        }

        .menu-button {
            display: none;
        }

        /* The popover attribute stays, so this has to undo the browser's popover styles. */
        .nav-pane {
            position: static;
            display: block;
            width: auto;
            height: auto;
            padding: 0 0 1.25rem;
            overflow: visible;
            border: 0;
        }
    }
</style>
