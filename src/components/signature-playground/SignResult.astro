---
import ToolButton from "./ToolButton.astro";
---

<div class="sign-only">
    <h5>Headers to Send</h5>
    <pre class="astro-code worked-out headers"><code data-output="headers"></code></pre>
    <div class="actions">
        <ToolButton output="check-this">Verify this signature</ToolButton>
    </div>

    <h5>Signing Key</h5>
    <div class="key-row">
        <p>Signed with <span data-output="key-label">the example key</span>.</p>
        <div class="actions">
            <ToolButton output="generate">Make a new key</ToolButton>
            <ToolButton output="use-example" hidden>Use the example key</ToolButton>
        </div>
    </div>
    <p class="worked-out public"><span>Public key</span> <code data-output="public-key"></code></p>
    <p class="aside">Real private keys do not belong on a web page, so there is no field for one.</p>
</div>

<style>
    .headers {
        font-size: var(--code-size);
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-block: 0.5rem;
    }

    .key-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.25rem 1rem;
        margin-bottom: 0.5rem;
    }

    .key-row p,
    .key-row .actions {
        margin: 0;
    }

    .public span {
        display: block;
        color: var(--ink-soft);
    }

    .public code {
        display: block;
        color: var(--value);
        font-size: var(--code-size);
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    p.aside {
        margin: 0.5rem 0 0;
        color: var(--ink-soft);
    }
</style>
