---
import { sample } from "../../lib/signed-sample.ts";
import { signingParts } from "../../lib/signing.ts";
import SigningString from "../spec/SigningString.astro";
import Inputs from "./Inputs.astro";
import SignResult from "./SignResult.astro";
import VerifyResult from "./VerifyResult.astro";

const [method, domain, path, timestamp, hash] = await signingParts(sample);
---

<section data-playground class="playground wide" data-mode="sign" hidden data-pagefind-ignore>
    <header class="head">
        <div class="head-row">
            <h4 id="try-it">Try It</h4>
            <fieldset class="modes" data-output="modes" aria-label="What to do" hidden>
                <label><input type="radio" name="mode" value="sign" checked /> Sign a message</label>
                <label><input type="radio" name="mode" value="verify" /> Verify a signature</label>
            </fieldset>
        </div>
        <p data-output="unsupported" hidden>
            This tool needs Ed25519 in the browser: Chrome 137, Firefox 129, Safari 17 or later.
        </p>
        <p class="intro" data-output="intro" hidden>
            Everything here runs in your browser, and nothing is sent anywhere. It starts with the message from the{" "}
            <a href="/">home page</a>.
        </p>
    </header>

    <form data-output="tool" hidden autocomplete="off">
        <div class="bench">
            <Inputs />

            <div class="outputs">
                <h5>Signing String</h5>
                <SigningString
                    parts={[
                        ["$0", "", method ?? ""],
                        ["$1", "", domain ?? ""],
                        ["$2", "", path ?? ""],
                        ["$3", "", timestamp ?? ""],
                        ["$4", "", hash ?? ""],
                    ]}
                />

                <SignResult />
                <VerifyResult />
            </div>
        </div>
    </form>
</section>

<script>
    import "../../lib/signature-playground/index.ts";
</script>

<style>
    /* A frame and a header strip, so the tool does not read as more of the specification. Its
       controls already have this border, as does the search box. */
    .playground {
        margin-block: 2rem;
        border: 1px solid var(--control-border);
        border-radius: var(--radius);
        font-size: var(--text-sm);
        line-height: 1.5;
    }

    .head {
        padding: 0.75rem 1rem;
        background: var(--paper-raised);
        border-bottom: 1px solid var(--control-border);
    }

    .head-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.25rem 1.5rem;
    }

    .head h4 {
        margin: 0;
        color: var(--ink);
        font-family: var(--font-prose);
        font-size: var(--text-body);
        font-weight: var(--weight-bold);
        line-height: 1.3;
    }

    .head p {
        margin: 0.25rem 0 0;
    }

    .intro {
        color: var(--ink-soft);
    }

    .modes {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.5rem;
        margin: 0;
        padding: 0;
        border: 0;
    }

    .modes[hidden] {
        display: none;
    }

    .modes input {
        accent-color: var(--accent);
    }

    .bench {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0 2rem;
        padding: 0.25rem 1rem 1rem;
    }

    /* The results sit beside the inputs where there is room, so an edit shows without scrolling. */
    @media (min-width: 78rem) {
        .bench {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }
    }

    /* Here the fields beside it already say what each part is, so `$0` to `$4` label a table. */
    .outputs :global(.signing-string) {
        margin: 0 0 0.5rem;
    }

    .outputs :global(.signing-string dl) {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        gap: 0.15rem 1rem;
        align-items: baseline;
    }

    .outputs :global(.signing-string dl > div) {
        display: contents;
    }

    /* The rest of this block is what the sections inside the frame share. */
    .playground :global(h5) {
        margin: 1rem 0 0.35rem;
        color: var(--ink);
        font-family: var(--font-prose);
        font-size: var(--text-sm);
        font-weight: var(--weight-bold);
        line-height: 1.3;
    }

    /* Which of the two a mode shows. */
    .playground[data-mode="sign"] :global(.verify-only),
    .playground[data-mode="verify"] :global(.sign-only) {
        display: none;
    }

    /* Everything worked out from the input sits on the same shade. */
    .playground :global(.worked-out) {
        margin: 0;
        padding: 0.75rem 1rem;
        background: var(--paper-raised);
        border-radius: var(--radius);
    }

    /* The part of the string that the focused field or hovered part feeds. */
    .playground :global(:is(code, span).part-active) {
        background: var(--accent-tint);
    }

    /* A field only changes its border: a tint over a whole body would be hard to read through. */
    .playground :global(:is(input, textarea).part-active) {
        border-color: var(--accent);
    }
</style>
