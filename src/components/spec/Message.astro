---
interface Props {
    /** The lane this starts from. */
    from: "a" | "b";
    /** A new request from `b`, which otherwise answers `a`. */
    request?: boolean;
    /** Something an instance does by itself, with no arrow. */
    local?: boolean;
    /** What crosses over, such as a request line, status code or entity, when worth showing. */
    label?: string;
}

const { from, request = from === "a", local = false, label } = Astro.props;
---

<li class:list={["step", `from-${from}`, { local }]}>
    {!local && <span class="visually-hidden">{request ? "Request:" : "Response:"}</span>}
    {label && <code class="label">{label}</code>}
    {!local && <span class="arrow" aria-hidden="true"></span>}
    {Astro.slots.has("default") && <div class="text"><slot /></div>}
</li>

<style>
    .step {
        margin: 0;
        padding: 0.75rem 1rem;
        font-size: var(--text-sm);
        line-height: 1.45;
    }

    /* Each message reads from the side it leaves, like the arrow under it. */
    .from-b {
        text-align: right;
    }

    .local .text {
        color: var(--ink-soft);
        font-style: italic;
    }

    .label {
        display: block;
        font-size: var(--code-size);
        font-weight: var(--weight-bold);
        overflow-wrap: anywhere;
    }

    /* Direction has a colour: pink leaves `a`, the companion colour comes back from `b`. */
    .arrow {
        position: relative;
        display: block;
        height: 2px;
        margin: 0.35rem -1rem 0.4rem;
        background: var(--accent);
    }

    .from-b .arrow {
        background: var(--value);
    }

    .arrow::after {
        content: "";
        position: absolute;
        top: -0.3rem;
        right: 0;
        width: 0.6rem;
        height: calc(0.6rem + 2px);
        background: inherit;
        clip-path: polygon(0 0, 100% 50%, 0 100%);
    }

    .from-b .arrow::after {
        right: auto;
        left: 0;
        clip-path: polygon(100% 0, 0 50%, 100% 100%);
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
</style>
