---
interface Props {
    name: string;
    href: string;
}

const { name, href } = Astro.props;
---

<a class="field-name" href={href}><code>{name}</code></a>

<style>
    .field-name {
        color: var(--accent);
        font-weight: var(--weight-bold);
        text-decoration: none;
    }

    .field-name code {
        padding: 0;
        background: none;
        font-size: calc(var(--text-body) * var(--mono-ratio));
        font-weight: var(--weight-bold);
    }

    .field-name:hover {
        text-decoration: underline;
    }
</style>
