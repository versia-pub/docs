---
import { API_PREFIX } from "../../lib/spec";
import Col from "./Col.astro";
import Fact from "./Fact.astro";
import Facts from "./Facts.astro";
import Sheet from "./Sheet.astro";
import SheetLabel from "./SheetLabel.astro";

interface Props {
    name: string;
    /** Value of the `type` field, such as "Note" or "pub.versia:groups/Group". */
    type: string;
    transient?: boolean;
    /** For an entity with its own endpoint instead of the usual entity data one. */
    fetch?: { path: string; href: string };
}

const { name, type, transient = false, fetch } = Astro.props;
const fetchPath = fetch?.path ?? `${API_PREFIX}/entities/${encodeURIComponent(type)}/{id}`;
const fetchHref = fetch?.href ?? "/api/endpoints#entity-data";
---

<Sheet entity={name}>
    <Facts slot="meta">
        <Fact label="Type"><code class="type-value">"{type}"</code></Fact>
        {transient ? (
            <Fact label="Lifetime"><a href="/entities#transient-entities">Transient Entity</a></Fact>
        ) : (
            <Fact label="Fetch" href={fetchHref}><code>GET {fetchPath}</code></Fact>
        )}
        {Astro.slots.has("collections") && (
            <Fact label="Collections" href="/api/endpoints#entity-collections" id="collections">
                <div class="collections"><slot name="collections" /></div>
            </Fact>
        )}
    </Facts>
    <Col>
        <SheetLabel>Fields</SheetLabel>
        <slot />
    </Col>
    <Col sticky><slot name="example" /></Col>
</Sheet>

<style>
    .type-value {
        color: var(--value);
    }

    .collections :global(ul) {
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>
