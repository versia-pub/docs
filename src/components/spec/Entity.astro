---
import { API_PREFIX } from "../../lib/spec";
import Col from "./Col.astro";
import Sheet from "./Sheet.astro";
import SheetLabel from "./SheetLabel.astro";

interface Props {
    name: string;
    /** Value of the `type` field, such as "Note" or "pub.versia:groups/Group". */
    type: string;
    transient?: boolean;
    collections?: { name: string; of: string; description: string }[];
}

const { name, type, transient = false, collections = [] } = Astro.props;
---

<Sheet entity={name}>
    <dl slot="meta" class="sheet-meta">
        <div><dt>Type</dt><dd><code class="type-value">"{type}"</code></dd></div>
        {transient ? (
            <div>
                <dt>Lifetime</dt>
                <dd><a href="/entities#transient-entities">Transient Entity</a></dd>
            </div>
        ) : (
            <div>
                <dt><a href="/api/endpoints#entity-data">Fetch</a></dt>
                <dd><code>GET {API_PREFIX}/entities/{encodeURIComponent(type)}/{"{id}"}</code></dd>
            </div>
        )}
        {collections.length > 0 && (
            <div id="collections">
                <dt><a href="/api/endpoints#entity-collections">Collections</a></dt>
                <dd>
                    <ul>
                        {collections.map((collection) => (
                            <li>
                                <code>{collection.name}</code>{" "}
                                <a href="/structures/collection#uri-collection">URI Collection</a>{" "}
                                of {collection.of}: {collection.description}
                            </li>
                        ))}
                    </ul>
                </dd>
            </div>
        )}
    </dl>
    <Col>
        <SheetLabel>Fields</SheetLabel>
        <slot />
    </Col>
    <Col sticky><slot name="example" /></Col>
</Sheet>

<style>
    /* Header facts. */
    .sheet-meta {
        margin: 0;
        border-bottom: 1px solid var(--hair);
        font-size: 0.9rem;
        line-height: 1.45;
    }

    .sheet-meta > div {
        display: grid;
        grid-template-columns: 7rem minmax(0, 1fr);
        gap: 0 1rem;
        padding-block: 0.55rem;
    }

    @media (max-width: 30rem) {
        .sheet-meta > div {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .sheet-meta > div + div {
        border-top: 1px solid var(--hair);
    }

    .sheet-meta dt {
        color: var(--ink-soft);
    }

    .sheet-meta dt a {
        color: inherit;
        text-decoration-color: var(--hair);
    }

    .type-value {
        color: var(--value);
    }

    .sheet-meta dd {
        margin: 0;
    }

    .sheet-meta ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>
