---
import { API_PREFIX } from "../../lib/spec";
import Col from "./Col.astro";
import Fact from "./Fact.astro";
import Facts from "./Facts.astro";
import Sheet from "./Sheet.astro";
import SheetLabel from "./SheetLabel.astro";

interface Props {
    name: string;
    /** Value of the `type` field, such as "Note" or "pub.versia:groups/Group". Structures have none. */
    type?: string;
    transient?: boolean;
    collections?: { name: string; of: string; description: string }[];
}

const { name, type, transient = false, collections = [] } = Astro.props;
---

<Sheet entity={name}>
    {type && (
        <Facts slot="meta">
            <Fact label="Type"><code class="type-value">"{type}"</code></Fact>
            {transient ? (
                <Fact label="Lifetime"><a href="/entities#transient-entities">Transient Entity</a></Fact>
            ) : (
                <Fact label="Fetch" href="/api/endpoints#entity-data">
                    <code>GET {API_PREFIX}/entities/{encodeURIComponent(type)}/{"{id}"}</code>
                </Fact>
            )}
            {collections.length > 0 && (
                <Fact label="Collections" href="/api/endpoints#entity-collections" id="collections">
                    <ul class="collections">
                        {collections.map((collection) => (
                            <li>
                                <code>{collection.name}</code>{" "}
                                <a href="/structures/collection#uri-collection">URI Collection</a>{" "}
                                of {collection.of}: {collection.description}
                            </li>
                        ))}
                    </ul>
                </Fact>
            )}
        </Facts>
    )}
    <Col>
        <SheetLabel>Fields</SheetLabel>
        <slot />
    </Col>
    <Col sticky><slot name="example" /></Col>
</Sheet>

<style>
    .type-value {
        color: var(--value);
    }

    .collections {
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>
