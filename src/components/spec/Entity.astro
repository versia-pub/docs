---
import { API_PREFIX } from "../../lib/spec";
import EntityChecker from "../entity-checker/EntityChecker.astro";
import Col from "./Col.astro";
import Fact from "./Fact.astro";
import Facts from "./Facts.astro";
import Sheet from "./Sheet.astro";
import SheetLabel from "./SheetLabel.astro";

interface Props {
    name: string;
    /** Value of the `type` field, such as "Note" or "pub.versia:groups/Group". */
    type: string;
    transient?: boolean;
    /** For a non-transient entity with no `id`. Read by `remark-spec`. */
    idless?: boolean;
    /** For an entity with its own endpoint instead of the usual entity data one. */
    fetch?: { path: string; href: string };
    /** For an entity whose collections have their own endpoint. */
    collectionsHref?: string;
    /** Adds a tool under the sheet that checks a pasted entity against its fields. */
    checker?: boolean;
    /** Set by `remark-spec` for `checker`: the fields as JSON, and the example. Not `example`, which is a slot. */
    schema?: string;
    sample?: string;
}

const {
    name,
    type,
    transient = false,
    fetch,
    collectionsHref = "/federation/endpoints#entity-collections",
    schema,
    sample,
} = Astro.props;
const fetchPath = fetch?.path ?? `${API_PREFIX}/entities/${type}/{id}`;
const fetchHref = fetch?.href ?? "/federation/endpoints#entity-data";
---

<Sheet entity={name}>
    <Facts slot="meta">
        <Fact label="Type"><code class="type-value">"{type}"</code></Fact>
        {transient ? (
            <Fact label="Lifetime"><a href="/entities#transient-entities">Transient Entity</a></Fact>
        ) : (
            <Fact label="Fetch" href={fetchHref}><code>GET {fetchPath}</code></Fact>
        )}
        {Astro.slots.has("collections") && (
            <Fact label="Collections" href={collectionsHref} id="collections">
                <div class="collections"><slot name="collections" /></div>
            </Fact>
        )}
    </Facts>
    <Col>
        <SheetLabel>Fields</SheetLabel>
        <slot />
    </Col>
    <Col sticky><slot name="example" /></Col>
</Sheet>
{schema && sample && <EntityChecker name={name} transient={transient} schema={schema} sample={sample} />}

<style>
    .type-value {
        color: var(--value);
    }

    .collections :global(ul) {
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>
