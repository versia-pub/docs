---
import { typeLinks } from "../../lib/spec";

interface Props {
    value: string;
}

// Splits `Reference | "public"` into names, string literals and punctuation, keeping the spaces.
const tokens = Astro.props.value.match(/"[^"]*"|[A-Za-z_][A-Za-z0-9_]*|\s+|[^\s"A-Za-z_]+/g) ?? [];
---

<span class="type">
    {tokens.map((token) =>
        typeLinks[token] ? <a href={typeLinks[token]}>{token}</a>
        : token.startsWith('"') ? <span class="type-literal">{token}</span>
        : token === "|" ? <span class="type-op">|</span>
        : token
    )}
</span>

<style>
    .type {
        color: var(--ink-soft);
        font-family: var(--font-mono);
        font-size: var(--code-size);
    }

    /* The sentence below usually links the same word, so this one stays quiet. */
    .type a {
        color: inherit;
        text-decoration-color: var(--hair);
    }

    .type a:hover {
        color: var(--accent);
        text-decoration-color: currentColor;
    }

    .type-literal {
        color: var(--value);
    }

    .type-op {
        color: var(--ink-faint);
    }
</style>
