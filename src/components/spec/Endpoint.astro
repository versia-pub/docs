---
import { anchorPart } from "../../lib/spec-fields";
import Col from "./Col.astro";
import Fact from "./Fact.astro";
import Facts from "./Facts.astro";
import Sheet from "./Sheet.astro";

interface Props {
    /** Prefix of the anchors, in the form `well-known-method`. */
    name: string;
    method: "GET" | "POST";
    path: string;
    /** Whether the request and the response must be signed. */
    signature?: "required" | "exempt";
    /** The `Accept` header, if it is not the Versia one. */
    accept?: string;
}

const signatureText = {
    required: "Required for requests and responses.",
    exempt: "Not required for requests or responses.",
};

const { name, method, path, signature = "required", accept } = Astro.props;
const prefix = anchorPart(name);
// The capture group keeps the parameters in the result, at the odd indexes.
const pathParts = path.split(/(\{[^}]+\})/);
---

<Sheet>
    <p slot="meta" class="request">
        <code id={`${prefix}-method`} class="method">{method}</code>
        <code id={`${prefix}-endpoint`} class="path">{pathParts.map((part, index) =>
            index % 2 === 1 ? <span class="parameter">{part}</span> : part
        )}</code>
    </p>
    <Col>
        <Facts>
            <Fact label="Signature" href="/signatures">{signatureText[signature]}</Fact>
            {accept && <Fact label="Accept"><code>{accept}</code></Fact>}
            {Astro.slots.has("parameters") && <Fact label="Parameters"><slot name="parameters" /></Fact>}
            {Astro.slots.has("response") && <Fact label="Response" id={`${prefix}-response`}><slot name="response" /></Fact>}
        </Facts>
    </Col>
    <Col sticky><slot name="example" /></Col>
</Sheet>

<style>
    .request {
        display: flex;
        flex-wrap: wrap;
        gap: 0 0.75rem;
        margin: 0;
    }

    .request code {
        padding: 0;
        background: none;
        font-size: calc(var(--mono-ratio) * 1em);
        overflow-wrap: anywhere;
    }

    .request code:target {
        background: var(--accent-tint);
    }

    .request .method {
        color: var(--accent);
        font-weight: var(--weight-bold);
    }

    .parameter {
        color: var(--value);
    }
</style>
