---
import { inheritedFieldHref, inheritedFields } from "../../lib/spec-fields.ts";
import FieldName from "./FieldName.astro";
import RequiredTag from "./RequiredTag.astro";
import Type from "./Type.astro";

interface Props {
    /** Added by `remark-spec`, with the names this entity lists itself or does not have. */
    omit?: string;
}

const omitted = Astro.props.omit?.split(",") ?? [];
const fields = inheritedFields.filter((field) => !omitted.includes(field.name));
---

<details class="inherits">
    <summary>Inherited from Entity: {fields.map((f) => f.name).join(", ")}</summary>
    <ul>
        {fields.map((field) => (
            <li>
                <FieldName name={field.name} href={inheritedFieldHref(field.name)} />{" "}
                <Type value={field.type} />{" "}
                {field.required && <RequiredTag />}
            </li>
        ))}
    </ul>
</details>

<style>
    .inherits {
        padding-block: 0.8rem;
        color: var(--ink-soft);
        font-size: var(--text-sm);
    }

    :global(.field) + .inherits {
        border-top: 1px solid var(--hair);
    }

    .inherits summary {
        cursor: pointer;
    }

    .inherits ul {
        margin: 0.6rem 0 0;
        padding: 0;
        list-style: none;
    }

    .inherits li {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.75rem;
        padding-block: 0.15rem;
    }
</style>
