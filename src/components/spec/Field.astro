---
import FieldName from "./FieldName.astro";
import RequiredTag from "./RequiredTag.astro";
import Type from "./Type.astro";

interface Props {
    name: string;
    type?: string;
    required?: boolean;
    numberType?: "f64" | "i64" | "u64";
    /** Added by `remark-spec`, in the form `note-is-sensitive`. */
    anchor?: string;
}

const numberTitles = {
    f64: "64-bit floating-point number",
    i64: "64-bit signed integer",
    u64: "64-bit unsigned integer",
};

const { name, type, required = false, numberType, anchor } = Astro.props;
---

<div class="field" id={anchor} data-field={name}>
    <div class="field-head">
        <FieldName name={name} href={`#${anchor}`} />
        {type && <Type value={type} />}
        {numberType && <abbr class="field-number" title={numberTitles[numberType]}>{numberType}</abbr>}
        {required && <RequiredTag />}
    </div>
    {Astro.slots.has("default") && <div class="field-body"><slot /></div>}
</div>

<style>
    .field {
        padding-block: 0.9rem;
        scroll-margin-top: 1.5rem;
        transition: background-color 0.15s;
    }

    .field + .field {
        border-top: 1px solid var(--hair);
    }

    .field-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.15rem 0.75rem;
        margin-bottom: 0.35rem;
    }

    .field-number {
        color: var(--ink-faint);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        text-decoration: none;
    }

    .field-body {
        font-size: var(--text-sm);
        line-height: 1.45;
    }

    .field-body > :global(:last-child) {
        margin-bottom: 0;
    }

    /* Nested structure fields. */
    .field-body .field {
        padding-block: 0.5rem;
        margin-left: 0.25rem;
        padding-left: 0.75rem;
        border-top: 0;
        border-left: 1px solid var(--hair);
    }

    .field-body .field .field-head {
        margin-bottom: 0;
    }

    .field-body .field + :global(:not(.field)) {
        margin-top: 0.75rem;
    }

    .field-body :global(.note) {
        margin-top: 0.75rem;
    }

    /* `is-linked` comes from `sheet-hover`, when the matching example key is hovered. */
    .field:target,
    .field.is-linked {
        background: var(--accent-tint);
        box-shadow:
            -0.75rem 0 0 var(--accent-tint),
            0.75rem 0 0 var(--accent-tint);
    }
</style>
