---
// One delivery, split into rows so each part can carry its note. The rows are
// fragments, so Shiki cannot tokenize them.
//
// The signature is real: it covers the exact bytes of the JSON below, signed with the
// example key from `/guides/signing-requests`. Any change to the body needs a new signature.
type Token = { text: string; kind?: "key" | "value" };

// Colours a line the way the code theme does: pink for keys, the companion colour for values.
const tokenize = (line: string): Token[] => {
    const header = line.match(/^[A-Z][\w-]*: /)?.[0];
    if (header) {
        return [
            { text: header.slice(0, -2), kind: "key" },
            { text: ": " },
            { text: line.slice(header.length), kind: "value" },
        ];
    }
    // The request line has no values to colour, only a path with digits in it.
    if (/^[A-Z]+ /.test(line)) {
        return [{ text: line }];
    }
    const tokens: Token[] = [];
    let last = 0;
    for (const match of line.matchAll(/("[^"]*")(\s*:)?|\b(?:true|false|null|\d+)\b/g)) {
        tokens.push({ text: line.slice(last, match.index) });
        tokens.push({ text: match[1] ?? match[0], kind: match[2] ? "key" : "value" });
        last = match.index + (match[1] ?? match[0]).length;
    }
    tokens.push({ text: line.slice(last) });
    return tokens;
};

const rows = [
    {
        code: `POST /.versia/v0.7/inbox
Host: b.example
Content-Type: application/vnd.versia+json`,
        title: "One inbox.",
        href: "/federation/endpoints#inbox",
        text: "A single endpoint receives messages for every user on the instance.",
    },
    {
        code: `Versia-Signed-By: a.example
Versia-Signed-At: 1733051946
Versia-Signature: odN8Tqt2nouQ1Zju37z/LcVvdY146qnXcFTvQ7UIdbTyDs1WSCHpkRnHl+i3dKGPlujAqtWSeDcz15beqGbFBA==
`,
        title: "Signed.",
        href: "/signatures",
        text: "Requests are signed with the instance’s Ed25519 key, and rejected if the timestamp is more than 5 minutes off.",
    },
    {
        code: `{
    "id": "782addd9-c051-4eea-8ba4-23d561d0c5bb",
    "type": "Note",
    "created_at": "2024-12-01T11:19:04Z",
    "author": "a.example:ac41xk9dfe7302",
    "category": "microblog",`,
        title: "Self-description.",
        href: "/principles#self-description",
        text: "Headers and transport stay out of the data. One plain JSON object holds everything needed to process the entity, with no JSON-LD.",
    },
    {
        code: `    "content": {
        "text/plain": {
            "content": "Hello, @joe@b.example! How are you doing today?"
        }
    },
    "visibility": "public",
    "mentions": [
        "b.example:bde22zi3ca8762"
    ],
    "attachments": [],
    "is_sensitive": false,
    "previews": [],`,
        title: "Determinism.",
        href: "/principles#determinism",
        text: "Text and media use the same structure, ContentFormat: one way to represent any single piece of data.",
    },
    {
        code: `    "extensions": {
        "pub.versia:custom_emojis": {
            "emojis": []
        }
    }
}`,
        title: "Extensions.",
        href: "/extensions",
        text: "Anything beyond the core sits under a namespaced key. Implementations that do not support it can ignore it.",
    },
];
---

<figure class="message wide">
    {rows.map((row) => (
        <div class="row">
            <pre><code>{row.code.split("\n").map((line) => (
                <span class="line" style={`--indent:${line.match(/^ */)?.[0].length ?? 0}ch`}>{tokenize(line).map((token) => <span class={token.kind}>{token.text}</span>)}</span>
            ))}</code></pre>
            {row.title && <p><a href={row.href}>{row.title}</a> {row.text}</p>}
        </div>
    ))}
    <figcaption>What <code>a.example</code> sends <code>b.example</code> when someone posts. The signature is real: it was made with the <a href="/guides/signing-requests#example-key">example key</a>, so you can <a href="/signatures#verifying-the-signature">verify it</a>. <a href="/example">See the whole exchange</a>.</figcaption>
</figure>

<style>
    .message {
        margin: 1.5rem 0 1rem;
    }

    .row {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.5rem;
        padding-block: 0.6rem;
    }

    pre {
        margin: 0;
        padding: 0.75rem 1rem;
        background: var(--paper-raised);
        border-radius: var(--radius);
        font-size: var(--code-size);
        line-height: 1.6;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .row p {
        margin: 0;
        color: var(--ink-soft);
        font-size: var(--text-sm);
        line-height: 1.45;
    }

    .key {
        color: var(--accent);
    }

    .value {
        color: var(--value);
    }

    /* Wrapped lines stay at their own indent. */
    .line {
        display: block;
        min-height: 1lh;
        padding-left: var(--indent);
        text-indent: calc(-1 * var(--indent));
    }

    figcaption {
        margin-top: 0.75rem;
        color: var(--ink-soft);
        font-size: var(--text-sm);
        font-style: italic;
    }

    /* The same columns as the reading text and its margin, with the rows closed up
       so the message reads as one block. On narrow screens each note sits between
       the rows it explains instead. */
    @media (min-width: 78rem) {
        .row {
            grid-template-columns: minmax(0, var(--prose-width)) var(--margin-width);
            gap: var(--margin-gap);
            padding-block: 0;
        }

        pre {
            padding-block: 0;
            border-radius: 0;
        }

        .row p {
            padding-bottom: 0.75rem;
        }

        .row:first-of-type pre {
            padding-top: 0.75rem;
            border-radius: var(--radius) var(--radius) 0 0;
        }

        .row:first-of-type p {
            padding-top: 0.75rem;
        }

        .row:last-of-type pre {
            padding-bottom: 0.75rem;
            border-radius: 0 0 var(--radius) var(--radius);
        }
    }
</style>
