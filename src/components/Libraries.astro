---
import { libraries } from "../lib/libraries.ts";
import Guide from "./Guide.astro";
---

{libraries.map(({ name, href, description, icon }) => (
    <Guide href={href} description={description}>
        <img slot="icon" src={icon} width="32" height="32" alt="" />
        <code slot="name">{name}</code>
    </Guide>
))}
