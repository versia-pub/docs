---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ExtensionList from "../components/ExtensionList.astro";
import SignedNote from "../components/SignedNote.astro";
import { maintainer } from "../lib/home.ts";

---

<StarlightPage
    frontmatter={{
        title: "Federation you can read.",
        description:
            "Versia is a federation protocol: signed JSON over HTTP, with a small core and namespaced extensions.",
    }}
>
    <p class="intro">
        Versia is a federation protocol: signed JSON over HTTP, with a small core and namespaced extensions.
        Here is one message, whole. <a href="/introduction">Read the introduction</a>, or start with{" "}
        <a href="/entities/note">a Note</a>.
    </p>

    <SignedNote />

    <h2>Extensions</h2>
    <p>The core stays small. Everything else is a namespaced <a href="/extensions">extension</a>, implemented in any combination.</p>
    <ExtensionList />

    <h2>Implement it</h2>
    <p>
        Versia can be implemented in any language. Start with the guide to{" "}
        <a href="/guides/implementing-a-receiver">implementing a receiver</a>, or use the{" "}
        <a href="/sdks">official TypeScript SDK</a>.
    </p>
    <p>
        <a href="https://github.com/versia-pub/verso">Verso</a> is the reference implementation. It also implements
        the Mastodon client API, so it works with the apps people already use. It is in early development and isn’t
        ready for production yet.
    </p>
    <p>This community could include you! Check out our <a href="https://github.com/versia-pub/docs">Git repository</a> to see how you can contribute.</p>

    <h2>Maintainer</h2>
    <p>
        Versia, formerly known as Lysand, is maintained by {maintainer.name} (<code>@{maintainer.username}</code>).
        You can ask {maintainer.name} for help with anything Versia-related, or if you just want to chat!
    </p>
    <ul class="socials">
        {maintainer.socials.map((social) => <li><a href={social.url}>{social.name}</a></li>)}
    </ul>

    <h2>Thanks</h2>
    <p>Thanks to <a href="https://fastly.com">Fastly</a> for supporting us with their resources!</p>
    <p><a href="https://fastly.com"><img class="sponsor" src="/logos/fastly.svg" alt="Fastly" height="64" /></a></p>
</StarlightPage>

<style>
    /* The front door gets a larger title than the documents behind it. */
    :global(h1#_top) {
        max-width: none;
        font-size: clamp(2.75rem, 6vw, 5rem);
        line-height: 1;
    }

    .intro {
        font-size: 1.25rem;
        line-height: 1.5;
    }

    .socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 0.75rem;
        padding: 0;
        list-style: none;
    }

    .socials li {
        margin: 0;
    }

    .sponsor {
        height: 4rem;
        width: auto;
    }
</style>
